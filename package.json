{
  "name": "node-ts-functional",
  "version": "1.0.0",
  "main": "server.js",
  "private": true,
  "author": "seaflux",
  "license": "ISC",
  "scripts": {
    "tsc": "tsc",
    "dev": "ts-node-dev --respawn -r tsconfig-paths/register --transpile-only src/index.ts",
    "start": "tsc && tsc-alias && node dist",
    "build": "tsc && tsc-alias",
    "prepare": "husky",
    "format": "biome check --write src/",
    "lint": "biome lint --error-on-warnings src/",
    "liquibase": "cd liquibase && liquibase update"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.12.17",
    "method-override": "^3.0.0",
    "morgan": "^1.10.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "stripe": "^22.2.3",
    "typeorm": "^0.3.26",
    "winston": "^3.14.2",
    "zod": "^4.1.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/bcrypt": "^6.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/method-override": "^3.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.5.2",
    "@types/supertest": "^6.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.6",
    "vitest": "^3.2.4"
  }
}
